# ============================================================
# .env.oracle.example — Oracle Cloud deployment env template
# ============================================================
# Copy this file to .env on your Oracle VM:
#   cp .env.oracle.example .env
#
# Then fill in every value marked with <...> before running:
#   docker compose up -d --build
# ============================================================

# ── PostgreSQL (managed by docker compose) ───────────────────
# These values are used by BOTH the postgres container and the backend.
POSTGRES_DB=reva
POSTGRES_USER=reva_user
POSTGRES_PASSWORD=<choose-a-strong-password>

# DATABASE_URL is set automatically in docker-compose.yml using the
# three POSTGRES_* vars above. You do NOT need to set it here.
# If you ever want to override it (e.g. external DB), uncomment:
# DATABASE_URL=postgresql+psycopg2://reva_user:<password>@postgres:5432/reva

# ── Redis (managed by docker compose) ────────────────────────
# Wired automatically via docker-compose.yml. No change needed.
# REDIS_URL=redis://redis:6379/0

# ── Core App ─────────────────────────────────────────────────
# IMPORTANT: generate a real secret — never use the example value.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<generate-with-command-above>

ENABLE_SCHEDULER=true

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Add your Cloudflare Tunnel URL here once you have it (step 7 in the guide).
CORS_ORIGINS=https://reva-front.vercel.app,http://localhost:3000

# ── Gemini / AI ──────────────────────────────────────────────
GEMINI_API_KEY=<your-gemini-api-key>

# ── Google OAuth (optional) ──────────────────────────────────
VITE_GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com

# ── Sentiment pipeline ────────────────────────────────────────
# Required only when ENABLE_SCHEDULER=true
NEWS_API=<your-newsapi.org-key>
DB_LINK=<your-mongodb-connection-string>

# ── ML Model Runtime ──────────────────────────────────────────
# "embedded" = models run in-process (default, easiest for single VM).
MODEL_RUNTIME_MODE=embedded
LAND_MODEL_API_URL=
HOUSE_MODEL_API_URL=
RENTAL_MODEL_API_URL=

# ── LSTM / Market Index ───────────────────────────────────────
LSTM_INDEX_ENABLED=true
MAX_INDEX_STALENESS_MONTHS=12
SCALER_DOMAIN_TOLERANCE=0.25

# ── Geocoding ─────────────────────────────────────────────────
REVA_GEOCODING_ONLINE=false
REVA_GEOCODING_TIMEOUT=2.0
REVA_GEOCODE_CACHE=

# ── Portfolio Valuation ────────────────────────────────────────
PORTFOLIO_VALUATION_ENGINE=legacy
REVA_RENTAL_CAP_YIELD=0.0926

# ── Anchor months (optional) ──────────────────────────────────
REVA_LAND_ANCHOR_MONTH=
REVA_HOUSE_ANCHOR_MONTH=
REVA_RENTAL_ANCHOR_MONTH=
