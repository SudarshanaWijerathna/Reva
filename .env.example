# Core backend
# Replace all placeholders with real values (do not keep <...> in the final value).

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Option A — Azure Postgres (existing setup):
DATABASE_URL=postgresql+psycopg2://username:password@backend-postgres-reva.postgres.database.azure.com:5432/reva?sslmode=require
# Option B — Oracle Cloud (docker compose wires this automatically from POSTGRES_* vars):
# POSTGRES_DB=reva
# POSTGRES_USER=reva_user
# POSTGRES_PASSWORD=<your-password>

ENABLE_SCHEDULER=false

# Authentication
SECRET_KEY=mysecretkey123
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Optional external model endpoints (for dynamic house/rental predictions)
HOUSE_MODEL_API_URL=https://<house-model-service>/predict
RENTAL_MODEL_API_URL=https://<rental-model-service>/predict

# Optional sentiment pipeline envs (required only when ENABLE_SCHEDULER=true)
NEWS_API=
DB_LINK=

# Optional Redis cache for sentiment snapshots.
# If omitted, the backend will compute sentiment directly from MongoDB.
# For Docker Compose (Oracle Cloud): REDIS_URL=redis://redis:6379/0
REDIS_URL=

# CORS — comma-separated list of allowed frontend origins.
# Defaults to Vercel + localhost if not set.
# Add your Cloudflare Tunnel URL here once you have it.
# CORS_ORIGINS=https://reva-front.vercel.app,https://xxxx.trycloudflare.com
CORS_ORIGINS=

# ============================================================================
# Prediction stack
# ============================================================================

# Where the per-property models run. "embedded" (default) uses the artifacts in
# ml/; set "service" to require an explicit <TYPE>_MODEL_API_URL instead.
MODEL_RUNTIME_MODE=embedded
LAND_MODEL_API_URL=
# Sentinel values local / local://<type> force the embedded model for one type.

# --- Market index -----------------------------------------------------------
# Kill switch for the LSTM forecast path. Disabling it flattens the forward
# sequence and leaves the model price untouched. Per the walk-forward backtest in
# ml/market_index_training_report.json the LSTM loses to a naive forecast at every
# horizon, and a flat path IS the naive forecast, so "false" is the accurate
# setting as well as the safe one.
LSTM_INDEX_ENABLED=true
# Per asset: HOUSE_LSTM_INDEX_ENABLED / LAND_LSTM_INDEX_ENABLED / RENTAL_LSTM_INDEX_ENABLED

# Months of index staleness beyond which the gap is too wide to project across.
# The published CBSL index lags real time by a quarter or more; refresh it with
# scripts/build_market_index.py rather than raising this.
MAX_INDEX_STALENESS_MONTHS=12

# How far past [0, 1] a scaled model input may drift before it is treated as
# evidence that the wrong scaler is loaded. Lower is stricter.
SCALER_DOMAIN_TOLERANCE=0.25

# Anchor month overrides, format YYYY-MM. Land and house are measured from their
# training corpora; rental is unset because its corpus is 2022-23 and its own
# temporal test reports 58.8% MAPE out of period, so no correction is applied.
REVA_LAND_ANCHOR_MONTH=
REVA_HOUSE_ANCHOR_MONTH=
REVA_RENTAL_ANCHOR_MONTH=

# --- Geocoding --------------------------------------------------------------
# Live geocoding is opt-in. Nominatim allows one request per second and blocks
# server IPs past that, so the request path uses data/geo/sri_lanka_gazetteer.csv
# instead. Enable this only with a cache and a rate limiter in front of it.
REVA_GEOCODING_ONLINE=false
REVA_GEOCODING_TIMEOUT=2.0
REVA_GEOCODE_CACHE=

# --- Portfolio valuation ----------------------------------------------------
# legacy        previous behaviour, including summing per-perch land rates and
#               monthly rents as if they were capital values
# scraper_fixed the same scraper prices with the units corrected
# hybrid        property AVM anchor moved only by a matched observed index;
#               returns unavailable when required property facts are missing
#
# Compare all three before switching:
#   python scripts/compare_valuation_engines.py --user-id <id>
PORTFOLIO_VALUATION_ENGINE=hybrid

# Annual yield used to capitalise a monthly rent into a capital value. Left blank,
# it is derived from the scraper's own national averages.
REVA_RENTAL_CAP_YIELD=0.0926

# Forecast paths are disabled by default: current LSTM backtests do not beat the
# naive flat benchmark. This does not disable observed-index current valuations.
LSTM_INDEX_ENABLED=false
